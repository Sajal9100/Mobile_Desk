# MobileDesk server - environment variables.
# NAMES AND SAFE PLACEHOLDERS ONLY. Copy to .env (gitignored) and fill in local values.
# In staging/production these come from the secrets manager, never from a file.

NODE_ENV=development            # development | test | production
PORT_API=3000
PORT_REALTIME=3001
BIND_HOST=127.0.0.1             # use 0.0.0.0 only inside containers
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
CORS_ORIGINS=                   # empty = no CORS (mobile-only). Comma-separated https origins otherwise.
APP_PUBLIC_BASE_URL=http://localhost:3000

# --- used when the server runs on the host (npm run dev:*) ---
DATABASE_URL=postgresql://mobiledesk:CHANGE_ME@127.0.0.1:5432/mobiledesk
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0

# --- used by infra/docker-compose.yml (must match the two URLs above) ---
POSTGRES_USER=mobiledesk
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=mobiledesk
POSTGRES_HOST_PORT=5432
REDIS_PASSWORD=CHANGE_ME
REDIS_HOST_PORT=6379
