# MobileDesk server - environment variables.
# NAMES AND SAFE PLACEHOLDERS ONLY. Copy to .env (gitignored) and fill in local values.
# In staging/production these come from the secrets manager, never from a file.

NODE_ENV=development            # development | test | production
PORT_API=3000
PORT_REALTIME=3001
BIND_HOST=127.0.0.1             # use 0.0.0.0 only inside containers
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
# CORS_ORIGINS: empty = no CORS (mobile-only). Comma-separated https origins otherwise.
CORS_ORIGINS=
APP_PUBLIC_BASE_URL=http://localhost:3000

# --- used when the server runs on the host (npm run dev:*) ---
DATABASE_URL=postgresql://mobiledesk:CHANGE_ME@127.0.0.1:5432/mobiledesk
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0

# --- used by infra/docker-compose.yml (must match the two URLs above) ---
POSTGRES_USER=mobiledesk
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=mobiledesk
POSTGRES_HOST_PORT=5432
REDIS_PASSWORD=CHANGE_ME
REDIS_HOST_PORT=6379

# --- accounts and authentication (Phase 2) ---
# JWT signing keys: a JSON map of key id -> Ed25519 PEM, from the secrets manager (never commit).
# Local development: run `node scripts/gen-jwt-key.mjs`, which fills in both lines in your .env.
JWT_PRIVATE_KEYS=
JWT_ACTIVE_KID=
# enforce = verify Play Integrity with Google (staging, production). bypass = local development only;
# the server refuses to start with bypass when NODE_ENV=production.
INTEGRITY_MODE=bypass
# The three values below are needed only when INTEGRITY_MODE=enforce.
INTEGRITY_PACKAGE_NAME=
# SHA-256 of the app signing certificate (Play Console > App integrity); several allowed, comma separated.
INTEGRITY_CERT_SHA256=
# The service account key file as one line of JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Which proxies may set X-Forwarded-For. Empty = none (the client IP is the socket address).
# Behind a load balancer set a hop count such as 1, or the proxy CIDRs. Never "true".
TRUST_PROXY=
